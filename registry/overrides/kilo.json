{
  "env": {
    "HOME": "${WORK_DIR}",
    "KILO_API_KEY": "probe-mock-key",
    "OPENAI_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "kilo.json": {
      "$schema": "https://app.kilo.ai/config.json",
      "model": "openai-compatible/probe-model",
      "provider": {
        "openai-compatible": {
          "npm": "@ai-sdk/openai-compatible",
          "options": { "baseURL": "${MOCK_LLM_URL}", "apiKey": "probe-mock-key" },
          "models": { "probe-model": { "name": "probe-model", "tool_call": true } }
        }
      },
      "permission": { "bash": "ask", "edit": "ask", "webfetch": "ask" }
    }
  },
  "notes": "Kilo CLI is an OpenCode fork reading ./kilo.json[c] from cwd — mirrors the verified opencode wiring: openai-compatible provider → mock LLM, permission=ask to deterministically exercise session/request_permission."
}
