{
  "install": "npm exec --yes --package=autohand-cli@0.9.8 --package=@autohandai/autohand-acp@0.2.1 -- node -e \"\"",
  "env": {
    "AUTOHAND_CONFIG": "${WORK_DIR}/autohand-config.json",
    "AUTOHAND_HOME": "${WORK_DIR}/autohand-home",
    "AUTOHAND_PERMISSION_MODE": "external"
  },
  "sessionFiles": {
    "autohand-config.json": {
      "provider": "custom:probe",
      "customProviders": {
        "probe": {
          "id": "probe",
          "displayName": "Probe",
          "apiFormat": "openai-compatible",
          "baseUrl": "${MOCK_LLM_URL}",
          "apiKey": "probe-mock-key",
          "apiKeyRequired": true,
          "model": "probe-model"
        }
      }
    }
  },
  "notes": "Test the registry legacy ACP adapter, with its required autohand executable supplied by the official autohand-cli package (0.9.8), not nonexistent @autohandai/code-cli. Both packages are prepared before ACP starts; no global installation or native-adapter substitution.",
  "run": "npm exec --yes --package=autohand-cli@0.9.8 --package=@autohandai/autohand-acp@0.2.1 -- autohand-acp"
}
