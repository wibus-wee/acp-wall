{
  "name": "kimi",
  "display": "Kimi CLI",
  "vendor": "Moonshot AI",
  "version": "1.52.0",
  "description": "Moonshot AI's coding assistant",
  "repo": "MoonshotAI/kimi-cli",
  "website": "https://moonshotai.github.io/kimi-cli/",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/kimi.svg",
  "license": "MIT",
  "install": "node tools/lody-adapters.mjs kimi",
  "run": "node ${REPO_ROOT}/.cache/adapters/kimi/apps/kimi-code/dist/main.mjs acp",
  "env": {
    "KIMI_CODE_HOME": "${WORK_DIR}/kimi-home"
  },
  "sessionFiles": {
    "kimi-home/config.toml": "defaultModel = \"probe-model\"\ndefault_permission_mode = \"ask\"\ntelemetry = false\n\n[models.probe-model]\nname = \"probe-model\"\nprotocol = \"openai\"\nbaseUrl = \"${MOCK_LLM_URL}\"\napiKey = \"probe-mock-key\"\nmaxContextSize = 8192\n",
    "kimi-home/credentials/kimi-code.json": {
      "access_token": "acp-probe-fake-token",
      "refresh_token": "acp-probe-refresh",
      "expires_at": 4102444800000,
      "scope": "all",
      "token_type": "Bearer",
      "expires_in": 31536000
    }
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
