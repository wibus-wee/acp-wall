{
  "name": "harn",
  "display": "Harn",
  "vendor": "Burin Labs",
  "version": "0.10.151",
  "description": "Harn runs .harn agent pipelines as a native ACP coding agent over stdio.",
  "repo": "burin-labs/harn",
  "website": "https://harnlang.com",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/harn.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/harn.json",
  "run": "${REPO_ROOT}/.cache/agents/harn/harn serve acp",
  "env": {
    "HARN_LLM_PROVIDER": "local",
    "LOCAL_LLM_BASE_URL": "${MOCK_LLM_URL}",
    "OPENAI_API_KEY": "probe-mock-key",
    "OPENAI_BASE_URL": "${MOCK_LLM_URL}"
  },
  "sessionFiles": null,
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.151/harn-aarch64-apple-darwin.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
          "acp"
        ],
        "sha256": "a667b4735ac1df6c68cc27ef30f3fb7f87b139cb48967ea5e219acab10b4ffd8"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.151/harn-x86_64-apple-darwin.tar.gz",
