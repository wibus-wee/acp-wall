          "serve",
          "acp"
        ],
        "sha256": "f88cc0f39f357509d5777307fbefaa336c266b1efaefe071bee9fa67d1bbf02c"
      },
      "linux-aarch64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.151/harn-aarch64-unknown-linux-gnu.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
          "acp"
        ],
        "sha256": "d86d38f8d3eb5608889be3b73451efb6790eb489d09c20f4eed3bbf6db870290"
      },
      "linux-x86_64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.151/harn-x86_64-unknown-linux-gnu.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
