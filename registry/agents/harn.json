{
  "name": "harn",
  "display": "Harn",
  "vendor": "Burin Labs",
  "version": "0.10.152",
  "description": "Harn runs .harn agent pipelines as a native ACP coding agent over stdio.",
  "repo": "burin-labs/harn",
  "website": "https://harnlang.com",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/harn.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/harn.json",
  "run": "${REPO_ROOT}/.cache/agents/harn/harn serve acp",
  "env": {
    "HARN_LLM_PROVIDER": "local",
    "LOCAL_LLM_BASE_URL": "${MOCK_LLM_URL}",
    "OPENAI_API_KEY": "probe-mock-key",
    "OPENAI_BASE_URL": "${MOCK_LLM_URL}"
  },
  "sessionFiles": null,
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.152/harn-aarch64-apple-darwin.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
          "acp"
        ],
        "sha256": "1a77d7c7791c93f1eb76870b5758efa75cc28394bc71cf48dda95ac49289b303"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.152/harn-x86_64-apple-darwin.tar.gz",
