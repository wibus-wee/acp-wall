          "acp"
        ],
        "sha256": "6d0ec9774f1d6167c8e7909b678bc520518c38fcc013ef0ae8d81dc71bbb97a8"
      },
      "linux-aarch64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.152/harn-aarch64-unknown-linux-gnu.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
          "acp"
        ],
        "sha256": "0cf4a94a3dbb1243f6f3639746fed72717635f627e1282d5fe8446b033635c92"
      },
      "linux-x86_64": {
        "archive": "https://github.com/burin-labs/harn/releases/download/v0.10.152/harn-x86_64-unknown-linux-gnu.tar.gz",
        "cmd": "./harn",
        "args": [
          "serve",
