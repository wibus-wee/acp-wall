        "sha256": "47a29af344bfc4d71704e5128532a60e62197fdcc797b35f32731228b5ce2658",
        "cmd": "./bin/kimchi",
        "args": [
          "--mode",
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/getkimchi/kimchi/releases/download/v1.1.30/kimchi_linux_arm64.tar.gz",
        "sha256": "b4c580c3525cf7f78c5e6909eeedc0addaf632c38852ad682aafcf876631e12b",
        "cmd": "./bin/kimchi",
        "args": [
          "--mode",
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/getkimchi/kimchi/releases/download/v1.1.30/kimchi_linux_amd64.tar.gz",
        "sha256": "d825f4ae3cf5ad2a232a4561df0ca7bdda17f2a65ec9449f6bd13ab6a6725748",
