        "cmd": "./bin/kimchi",
        "args": [
          "--mode",
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/getkimchi/kimchi/releases/download/v1.5.0/kimchi_linux_arm64.tar.gz",
        "sha256": "bcb36a1d63bb1183fbbde83f47c89ea5c08d0a84258d0a6d6059e3f6277a0d40",
        "cmd": "./bin/kimchi",
        "args": [
          "--mode",
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/getkimchi/kimchi/releases/download/v1.5.0/kimchi_linux_amd64.tar.gz",
        "sha256": "cdac1dd35750ec60d291bfb3c75ad85f46f01b6ddb1c3585f3518ac75c96f8ba",
