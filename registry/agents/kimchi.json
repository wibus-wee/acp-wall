  "disabled": false,
  "selftest": false,
  "notes": "kimchi resolves project .kimchi/config.json then ~/.config/kimchi/config.json — llmEndpoint is a documented OpenAI-compatible base (default llm.kimchi.dev/openai/v1) pointed at the mock; KIMCHI_API_KEY satisfies the credential path.",
  "_synced": "acp-registry 1.0.0 · 2026-10-02"
