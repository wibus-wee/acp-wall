{
  "name": "kimchi",
  "display": "Kimchi",
  "vendor": "Kimchi",
  "version": "1.1.30",
  "description": "Coding agent powered by multi-model orchestration",
  "repo": "getkimchi/kimchi",
  "website": "https://kimchi.dev",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/kimchi.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/kimchi.json",
  "run": "${REPO_ROOT}/.cache/agents/kimchi/bin/kimchi --mode acp",
  "env": {
    "KIMCHI_API_KEY": "probe-mock-key",
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".kimchi/config.json": {
      "apiKey": "probe-mock-key",
      "llmEndpoint": "${MOCK_LLM_URL}"
    },
    ".config/kimchi/config.json": {
      "apiKey": "probe-mock-key",
      "llmEndpoint": "${MOCK_LLM_URL}"
    }
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
