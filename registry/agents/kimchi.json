        "sha256": "9f91f8c0308a87be3fb7c0646b7924aeca58023452d97bf6ccc2530af6563bcd",
        "cmd": "./bin/kimchi",
        "args": [
          "--mode",
          "acp"
        ]
      },
      "darwin-x86_64": {
