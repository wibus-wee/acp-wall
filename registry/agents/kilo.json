{
  "name": "kilo",
  "display": "Kilo",
  "vendor": "Kilo Code",
  "version": "7.7.5",
  "description": "The open source coding agent",
  "repo": "Kilo-Org/kilocode",
  "website": "https://kilo.ai/",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/kilo.svg",
  "license": "MIT",
  "install": null,
  "run": "npx -y @kilocode/cli@7.7.5 acp",
  "env": {
    "HOME": "${WORK_DIR}",
    "KILO_API_KEY": "probe-mock-key",
    "OPENAI_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "kilo.json": {
      "$schema": "https://app.kilo.ai/config.json",
      "model": "openai-compatible/probe-model",
      "provider": {
        "openai-compatible": {
          "npm": "@ai-sdk/openai-compatible",
          "options": {
            "baseURL": "${MOCK_LLM_URL}",
            "apiKey": "probe-mock-key"
          },
          "models": {
            "probe-model": {
              "name": "probe-model",
              "tool_call": true
            }
          }
        }
      },
      "permission": {
        "bash": "ask",
        "edit": "ask",
        "webfetch": "ask"
      }
    }
  },
  "dist": {
    "type": "npx",
    "package": "@kilocode/cli@7.7.5",
    "args": [
      "acp"
    ]
  },
  "disabled": false,
  "selftest": false,
  "notes": "Kilo CLI is an OpenCode fork reading ./kilo.json[c] from cwd — mirrors the verified opencode wiring: openai-compatible provider → mock LLM, permission=ask to deterministically exercise session/request_permission.",
  "_synced": "acp-registry 1.0.0 · 2026-09-19"
}
