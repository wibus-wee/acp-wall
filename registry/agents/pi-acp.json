{
  "name": "pi-acp",
  "display": "pi ACP",
  "vendor": "Sergii Kozak <svkozak@gmail.com>",
  "version": "0.0.33",
  "description": "ACP adapter for pi coding agent",
  "repo": "svkozak/pi-acp",
  "website": null,
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/pi-acp.svg",
  "license": "MIT",
  "install": "node tools/lody-adapters.mjs pi",
  "run": "node ${REPO_ROOT}/.cache/adapters/pi/dist/index.js",
  "env": {
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".pi/agent/models.json": {
      "providers": {
        "probe": {
          "baseUrl": "${MOCK_LLM_URL}",
          "api": "openai-completions",
          "apiKey": "probe-mock-key",
          "authHeader": true,
          "models": [
            {
              "id": "probe-model",
              "name": "probe-model"
            }
          ]
        }
      }
    },
    ".pi/agent/settings.json": {
      "defaultModel": "probe/probe-model",
      "quietStartup": true
    }
  },
  "dist": {
    "type": "npx",
    "package": "pi-acp@0.0.33",
    "args": []
  },
  "disabled": false,
  "selftest": false,
  "notes": "pi-acp spawns `pi --mode rpc` — install puts pi on PATH and HOME=${WORK_DIR} lets sessionFiles plant .pi/agent/models.json declaring a custom openai-completions provider pointed at the mock LLM (documented models.json format). No pi account/subscription needed.",
  "_synced": "acp-registry 1.0.0 · 2026-09-22"
}
