{
  "name": "autohand",
  "display": "Autohand Code",
  "vendor": "Autohand AI",
  "version": "0.9.10",
  "description": "Autohand Code CLI with native ACP support",
  "repo": "autohandai/code-cli",
  "website": "https://github.com/autohandai/code-cli/blob/main/docs/guides/ACP.md",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/autohand.svg",
  "license": "Apache-2.0",
  "install": "npm exec --yes --package=autohand-cli@0.9.8 --package=@autohandai/autohand-acp@0.2.1 -- node -e \"\"",
  "run": "npm exec --yes --package=autohand-cli@0.9.8 --package=@autohandai/autohand-acp@0.2.1 -- autohand-acp",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "AUTOHAND_CONFIG": "${WORK_DIR}/autohand-config.json",
    "AUTOHAND_HOME": "${WORK_DIR}/autohand-home",
    "AUTOHAND_PERMISSION_MODE": "external"
  },
  "sessionFiles": {
    "autohand-config.json": {
      "provider": "custom:probe",
      "customProviders": {
        "probe": {
          "id": "probe",
          "displayName": "Probe",
          "apiFormat": "openai-compatible",
          "baseUrl": "${MOCK_LLM_URL}",
          "apiKey": "probe-mock-key",
          "apiKeyRequired": true,
          "model": "probe-model"
        }
      }
    }
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/autohandai/code-cli/releases/download/v0.9.10/autohand-macos-arm64.tar.gz",
        "sha256": "bd3aa36d0e0c5bc1105ffafa5d4f4e1723a98255b6e7d9c7b5c8705fa87eddc0",
        "cmd": "./autohand",
        "args": [
          "--acp"
        ]
      },
      "darwin-x86_64": {
