{
  "name": "cline",
  "display": "Cline",
  "vendor": "Cline Bot Inc.",
  "version": "3.0.74",
  "description": "Autonomous coding agent CLI - capable of creating/editing files, running commands, using the browser, and more",
  "repo": "cline/cline",
  "website": "https://cline.bot/cli",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/cline.svg",
  "license": "Apache-2.0",
  "install": null,
  "run": "npx -y cline@3.0.62 --acp",
  "setup": [
    "npx -y cline@3.0.62 auth -p openai -k probe-mock-key -b ${MOCK_LLM_URL} -m probe-model"
  ],
  "probeProfiles": [],
  "toolMappings": {
    "exec": {
      "tool": "run_commands",
      "args": {
        "commands": [
          "cat PROBE_CANARY.txt"
        ]
      }
    },
    "read": {
      "tool": "read_files",
      "args": {
        "files": [
          {
            "path": "${WORK_DIR}/PROBE_CANARY.txt"
          }
        ]
      }
    },
    "write": {
      "tool": "apply_patch",
      "args": {
        "input": "*** Begin Patch\n*** Add File: ${WORK_DIR}/probe-out.txt\n+CANARY-7729\n*** End Patch"
      }
    }
  },
  "env": {
    "CLINE_DIR": "${WORK_DIR}/cline-home",
    "CLINE_PROVIDER": "openai-compatible",
    "CLINE_MODEL": "probe-model",
    "CLINE_API_KEY": "probe-mock-key",
    "CLINE_TELEMETRY_DISABLED": "1",
    "CLINE_NO_AUTO_UPDATE": "1",
    "OTEL_SDK_DISABLED": "true",
    "DO_NOT_TRACK": "1"
  },
  "sessionFiles": null,
  "dist": {
    "type": "npx",
    "package": "cline@3.0.74",
    "args": [
      "--acp"
    ]
  },
  "disabled": false,
  "selftest": false,
  "notes": "Isolated OpenAI-compatible mock provider. Setup output is separate from ACP stdout. CLINE_API_KEY is the documented ACP environment-key gate; no OAuth flow or real credentials are supplied.",
  "_synced": "acp-registry 1.0.0 · 2026-10-27"
}
