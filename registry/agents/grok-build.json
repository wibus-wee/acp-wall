{
  "name": "grok-build",
  "display": "Grok Build",
  "vendor": "xAI",
  "version": "1.0.41",
  "description": "xAI's coding agent and CLI",
  "repo": null,
  "website": "https://x.ai/cli",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/grok-build.svg",
  "license": "proprietary",
  "install": "node tools/lody-adapters.mjs grok",
  "run": "node ${REPO_ROOT}/.cache/adapters/grok/src/index.js",
  "env": {
    "GROK_HOME": "${WORK_DIR}/grok-home",
    "XAI_API_KEY": "probe-mock-key",
    "GROK_DISABLE_AUTOUPDATER": "1",
    "GROK_PATH": "${REPO_ROOT}/.cache/adapters/grok-runtime/node_modules/.bin/grok"
  },
  "sessionFiles": {
    "grok-home/config.toml": "[models]\ndefault = \"probe-model\"\n\n[model.probe-model]\nmodel = \"probe-model\"\nbase_url = \"${MOCK_LLM_URL}\"\nenv_key = \"XAI_API_KEY\"\napi_backend = \"chat_completions\"\n"
  },
  "dist": {
    "type": "npx",
    "package": "@xai-official/grok@1.0.41",
    "args": [
      "agent",
      "stdio"
    ]
  },
  "disabled": false,
  "selftest": false,
  "notes": "GROK_HOME relocates grok's state dir into the probe workspace; config.toml defines a custom model whose base_url is the mock LLM (chat_completions backend) and XAI_API_KEY satisfies the api-key auth path — no grok login / SuperGrok subscription needed.",
  "_synced": "acp-registry 1.0.0 · 2026-09-24"
}
