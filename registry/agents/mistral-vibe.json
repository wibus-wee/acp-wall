{
  "name": "mistral-vibe",
  "display": "Mistral Vibe",
  "vendor": "Mistral AI",
  "version": "3.1.0",
  "description": "Mistral's open-source coding assistant",
  "repo": "mistralai/mistral-vibe",
  "website": "https://mistral.ai/products/vibe",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/mistral-vibe.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/mistral-vibe.json",
  "run": "${REPO_ROOT}/.cache/agents/mistral-vibe/agent",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "VIBE_HOME": "${WORK_DIR}/vibe-home",
    "PROBE_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "vibe-home/config.toml": "active_model = \"probe\"\nenable_auto_update = false\nenable_telemetry = false\n\n[[providers]]\nname = \"probe\"\napi_base = \"${MOCK_LLM_URL}\"\napi_key_env_var = \"PROBE_API_KEY\"\napi_style = \"openai\"\nbackend = \"generic\"\n\n[[models]]\nname = \"probe-model\"\nprovider = \"probe\"\nalias = \"probe\"\n",
    "vibe-home/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.0/vibe-acp-darwin-aarch64-3.1.0.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "c56ec63bd6bcd60591bee441cf31f3fe555da493275a1756b2f5152039f65ec4"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.0/vibe-acp-darwin-x86_64-3.1.0.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "6a7e3399f344e43ad38851b56cbff522cde5af714fca1139c5d04d778ba2dea9"
      },
      "linux-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.0/vibe-acp-linux-aarch64-3.1.0.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "96276b6d7cc49473e48a79f95c397a05dc7f8b1d5c459893562e0dd533112074"
      },
      "linux-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.0/vibe-acp-linux-x86_64-3.1.0.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "31e03174516ddc1b8dc2a229a3085ba59a50f4b380753a510ebb204730da4def"
      },
      "windows-x86_64": {
