{
  "name": "mistral-vibe",
  "display": "Mistral Vibe",
  "vendor": "Mistral AI",
  "version": "3.0.3",
  "description": "Mistral's open-source coding assistant",
  "repo": "mistralai/mistral-vibe",
  "website": "https://mistral.ai/products/vibe",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/mistral-vibe.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/mistral-vibe.json",
  "run": "${REPO_ROOT}/.cache/agents/mistral-vibe/agent",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "VIBE_HOME": "${WORK_DIR}/vibe-home",
    "PROBE_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "vibe-home/config.toml": "active_model = \"probe\"\nenable_auto_update = false\nenable_telemetry = false\n\n[[providers]]\nname = \"probe\"\napi_base = \"${MOCK_LLM_URL}\"\napi_key_env_var = \"PROBE_API_KEY\"\napi_style = \"openai\"\nbackend = \"generic\"\n\n[[models]]\nname = \"probe-model\"\nprovider = \"probe\"\nalias = \"probe\"\n",
    "vibe-home/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.0.3/vibe-acp-darwin-aarch64-3.0.3.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "6ead876685191ab26a91e749aba9452bc13360cf16186c09221ebcdf64145620"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.0.3/vibe-acp-darwin-x86_64-3.0.3.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "b4e968a5427c89a76363ad2dfb73e8db889b1c20aebfa43a07b30ebc08efb707"
      },
      "linux-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.0.3/vibe-acp-linux-aarch64-3.0.3.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "98f46403512ea44c6432ed4c14e2b2d4cd900fe9db8a5bd8930c594ab6424f83"
      },
      "linux-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.0.3/vibe-acp-linux-x86_64-3.0.3.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "59ae5700ca17a2cb892ce8a3edb3bce02bd10efa0cb15e56afb964d5938e4d99"
      },
      "windows-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.0.3/vibe-acp-windows-x86_64-3.0.3.zip",
        "cmd": "./vibe-acp.exe",
        "sha256": "91a96c01ee4fa9d7510b777e0bce6d4a9706ed8aa4ac3e715f1a5586d2707d4f"
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "VIBE_HOME relocates vibe's config dir into the probe workspace; config.toml defines a generic/openai provider pointed at the mock LLM with a probe model alias, and .env supplies the referenced key. No Mistral account sign-in needed.",
