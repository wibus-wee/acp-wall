{
  "name": "mistral-vibe",
  "display": "Mistral Vibe",
  "vendor": "Mistral AI",
  "version": "3.1.4",
  "description": "Mistral's open-source coding assistant",
  "repo": "mistralai/mistral-vibe",
  "website": "https://mistral.ai/products/vibe",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/mistral-vibe.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/mistral-vibe.json",
  "run": "${REPO_ROOT}/.cache/agents/mistral-vibe/agent",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "VIBE_HOME": "${WORK_DIR}/vibe-home",
    "PROBE_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "vibe-home/config.toml": "active_model = \"probe\"\nenable_auto_update = false\nenable_telemetry = false\n\n[[providers]]\nname = \"probe\"\napi_base = \"${MOCK_LLM_URL}\"\napi_key_env_var = \"PROBE_API_KEY\"\napi_style = \"openai\"\nbackend = \"generic\"\n\n[[models]]\nname = \"probe-model\"\nprovider = \"probe\"\nalias = \"probe\"\n",
    "vibe-home/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.4/vibe-acp-darwin-aarch64-3.1.4.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "4492735d66b615cb321e19e762199df957744ff9f8e7cccaf39fbebd55cad8a0"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.4/vibe-acp-darwin-x86_64-3.1.4.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "a5e2fac0ec4ea09c7c8fd218ae2acbb9b830ecd071668fe7f4293e793a104940"
      },
      "linux-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.4/vibe-acp-linux-aarch64-3.1.4.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "3db34e9f64920ddc819687e848ac3ebb730112538a56b0b64633bce6beccaf74"
      },
      "linux-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.4/vibe-acp-linux-x86_64-3.1.4.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "934a79356755821a31e6ce1aee7f7f1eacb6b1e6c78901acf1eb7fc4650aece7"
      },
      "windows-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.4/vibe-acp-windows-x86_64-3.1.4.zip",
        "cmd": "./vibe-acp.exe",
        "sha256": "4f8681d6e0496a258ba62acf57188961ebdfdc5799f26fe218adb43c637c7b79"
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "VIBE_HOME relocates vibe's config dir into the probe workspace; config.toml defines a generic/openai provider pointed at the mock LLM with a probe model alias, and .env supplies the referenced key. No Mistral account sign-in needed.",
