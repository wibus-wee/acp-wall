{
  "name": "mistral-vibe",
  "display": "Mistral Vibe",
  "vendor": "Mistral AI",
  "version": "3.1.1",
  "description": "Mistral's open-source coding assistant",
  "repo": "mistralai/mistral-vibe",
  "website": "https://mistral.ai/products/vibe",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/mistral-vibe.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/mistral-vibe.json",
  "run": "${REPO_ROOT}/.cache/agents/mistral-vibe/agent",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "VIBE_HOME": "${WORK_DIR}/vibe-home",
    "PROBE_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "vibe-home/config.toml": "active_model = \"probe\"\nenable_auto_update = false\nenable_telemetry = false\n\n[[providers]]\nname = \"probe\"\napi_base = \"${MOCK_LLM_URL}\"\napi_key_env_var = \"PROBE_API_KEY\"\napi_style = \"openai\"\nbackend = \"generic\"\n\n[[models]]\nname = \"probe-model\"\nprovider = \"probe\"\nalias = \"probe\"\n",
    "vibe-home/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.1/vibe-acp-darwin-aarch64-3.1.1.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "c5cec6fb85ca6249e68d6f9a60fbbfba3f0d4740ea97add3208170408fa98315"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.1/vibe-acp-darwin-x86_64-3.1.1.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "c229d6d118815c26d1d08ad7ce0afb38d399f90a873ee040f1b4518e4cfd1613"
      },
      "linux-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.1/vibe-acp-linux-aarch64-3.1.1.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "c2dbf99928f80b368a795af5ae870c6ccf2137ac06ad5478d52c44856ea6a219"
      },
      "linux-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.1/vibe-acp-linux-x86_64-3.1.1.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "ea3b33b2faebbd5cd2c4bc1c5226e865a8cafeb7486fb7fbd869418b4e4f6fec"
      },
      "windows-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v3.1.1/vibe-acp-windows-x86_64-3.1.1.zip",
        "cmd": "./vibe-acp.exe",
        "sha256": "ff827873a0506fdb110c9b6080f7a26bac804d6bdc49c6103b2f36873927f2fd"
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "VIBE_HOME relocates vibe's config dir into the probe workspace; config.toml defines a generic/openai provider pointed at the mock LLM with a probe model alias, and .env supplies the referenced key. No Mistral account sign-in needed.",
