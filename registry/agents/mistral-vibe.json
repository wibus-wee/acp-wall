{
  "name": "mistral-vibe",
  "display": "Mistral Vibe",
  "vendor": "Mistral AI",
  "version": "2.25.8",
  "description": "Mistral's open-source coding assistant",
  "repo": "mistralai/mistral-vibe",
  "website": "https://mistral.ai/products/vibe",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/mistral-vibe.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/mistral-vibe.json",
  "run": "${REPO_ROOT}/.cache/agents/mistral-vibe/vibe-acp",
  "env": {
    "VIBE_HOME": "${WORK_DIR}/vibe-home",
    "PROBE_API_KEY": "probe-mock-key"
  },
  "sessionFiles": {
    "vibe-home/config.toml": "active_model = \"probe\"\nenable_auto_update = false\nenable_telemetry = false\n\n[[providers]]\nname = \"probe\"\napi_base = \"${MOCK_LLM_URL}\"\napi_key_env_var = \"PROBE_API_KEY\"\napi_style = \"openai\"\nbackend = \"generic\"\n\n[[models]]\nname = \"probe-model\"\nprovider = \"probe\"\nalias = \"probe\"\n",
    "vibe-home/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.25.8/vibe-acp-darwin-aarch64-2.25.8.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "357305c3c728883eec26232763f4e414fcec51aafdcc75d04e2f78755f7917ce"
      },
      "darwin-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.25.8/vibe-acp-darwin-x86_64-2.25.8.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "5f1731d76d8c3f8031c2cfd7990cd79c9c4b234d2595e78b10b7b91b469fd6dc"
      },
      "linux-aarch64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.25.8/vibe-acp-linux-aarch64-2.25.8.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "09913291476fd2f8fc5c2b330602d6afded3ae6c016e197d9dcf805922bf82e8"
      },
      "linux-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.25.8/vibe-acp-linux-x86_64-2.25.8.tar.gz",
        "cmd": "./vibe-acp",
        "sha256": "dbe693ee66f29fdfcf9029dcbf3b2d4da138554b193e432b089840148ecf08b3"
      },
      "windows-x86_64": {
        "archive": "https://github.com/mistralai/mistral-vibe/releases/download/v2.25.8/vibe-acp-windows-x86_64-2.25.8.zip",
        "cmd": "./vibe-acp.exe",
        "sha256": "4eb3099bd06b034f62582f7b5ed701febbce3cf013ef95490aca9c79e82c4bd1"
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "VIBE_HOME relocates vibe's config dir into the probe workspace; config.toml defines a generic/openai provider pointed at the mock LLM with a probe model alias, and .env supplies the referenced key. No Mistral account sign-in needed.",
  "_synced": "acp-registry 1.0.0 · 2026-09-25"
}
