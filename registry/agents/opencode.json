          "options": {
            "baseURL": "${MOCK_LLM_URL}",
            "apiKey": "probe-mock-key"
          },
          "models": {
            "probe-model": {
              "name": "probe-model"
            }
          }
        }
      },
      "permission": {
        "bash": "ask",
        "edit": "ask",
        "webfetch": "ask"
      }
    }
  },
