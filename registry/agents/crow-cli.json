{
  "name": "crow-cli",
  "display": "crow-cli",
  "vendor": "Thomas Wood",
  "version": "0.1.49",
  "description": "Minimal ACP Native Coding Agent",
  "repo": "crow-cli/crow-cli",
  "website": "https://crow-ai.dev",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/crow-cli.svg",
  "license": "MIT",
  "install": "node tools/install-dist.mjs registry/agents/crow-cli.json",
  "run": "${REPO_ROOT}/.cache/agents/crow-cli/agent acp",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".agents/crow/config.yaml": "providers:\n  probe:\n    api_key: probe-mock-key\n    base_url: ${MOCK_LLM_URL}\nmodels:\n  probe-model:\n    provider: probe\n    model: probe-model\n",
    ".agents/crow/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.49/crow-cli-darwin-aarch64.tar.gz",
        "sha256": "e57bec141681d0843990ab2d536467a42cf33b4fe10a3374c152b83eb200cccd",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "darwin-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.49/crow-cli-darwin-x86_64.tar.gz",
        "sha256": "62941f0f3d35c9e722d92bee3a4a9a5f8c4c92c2bcf408f7a7268eb0f8d52a1f",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.49/crow-cli-linux-aarch64.tar.gz",
        "sha256": "7e4160ae3ffc0078a73fe78cab49cfe00bf854538991c47dbb25282d6a092685",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.49/crow-cli-linux-x86_64.tar.gz",
        "sha256": "0001d5019ec35e8a080844daa96d3ba91afd38ec44a89e5102291ebd36a1083c",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.49/crow-cli-windows-x86_64.zip",
        "sha256": "bcee58f1af378436d93b3386b62ce9a90dc3ed9614861ad28581c86577c4323a",
        "cmd": "./crow-cli.exe",
        "args": [
          "acp"
        ]
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "crow-cli reads providers/models from ~/.agents/crow/config.yaml (documented openai-compatible shape); HOME=${WORK_DIR} lets sessionFiles plant the config pointing at the mock LLM.",
  "_synced": "acp-registry 1.0.0 · 2026-11-11"
}
