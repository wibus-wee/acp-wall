{
  "name": "crow-cli",
  "display": "crow-cli",
  "vendor": "Thomas Wood",
  "version": "0.1.51",
  "description": "Minimal ACP Native Coding Agent",
  "repo": "crow-cli/crow-cli",
  "website": "https://crow-ai.dev",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/crow-cli.svg",
  "license": "MIT",
  "install": "node tools/install-dist.mjs registry/agents/crow-cli.json",
  "run": "${REPO_ROOT}/.cache/agents/crow-cli/agent acp",
  "setup": [],
  "probeProfiles": [],
  "env": {
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".agents/crow/config.yaml": "providers:\n  probe:\n    api_key: probe-mock-key\n    base_url: ${MOCK_LLM_URL}\nmodels:\n  probe-model:\n    provider: probe\n    model: probe-model\n",
    ".agents/crow/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.51/crow-cli-darwin-aarch64.tar.gz",
        "sha256": "2f8a82dae82268b183fe124b1da356bd80c70cf96b363f8623d47bbe7c707272",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "darwin-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.51/crow-cli-darwin-x86_64.tar.gz",
        "sha256": "e9c97fca4d206c1f4bace697c54255e7869d5bfb1a21985d16f9bdb55d44bb12",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.51/crow-cli-linux-aarch64.tar.gz",
        "sha256": "7c337a2a29f87ed02a2845ca1975659dcb8a8eb67c60d39a91921392ca6af763",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.51/crow-cli-linux-x86_64.tar.gz",
        "sha256": "f726ec8306f8dd765546efd3b28509f47dee5805abfe06d6f6e23af8e4e74ef8",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.51/crow-cli-windows-x86_64.zip",
        "sha256": "36dce298af476c835ff928174d4daee14445e0aeebca53ac91f4a358b73be4b4",
        "cmd": "./crow-cli.exe",
        "args": [
          "acp"
        ]
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "crow-cli reads providers/models from ~/.agents/crow/config.yaml (documented openai-compatible shape); HOME=${WORK_DIR} lets sessionFiles plant the config pointing at the mock LLM.",
  "_synced": "acp-registry 1.0.0 · 2026-11-28"
}
