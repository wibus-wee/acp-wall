{
  "name": "crow-cli",
  "display": "crow-cli",
  "vendor": "Thomas Wood",
  "version": "0.1.24",
  "description": "Minimal ACP Native Coding Agent",
  "repo": "crow-cli/crow-cli",
  "website": "https://crow-ai.dev",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/crow-cli.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/crow-cli.json",
  "run": "${REPO_ROOT}/.cache/agents/crow-cli/crow-cli acp",
  "env": {
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".agents/crow/config.yaml": "providers:\n  probe:\n    api_key: probe-mock-key\n    base_url: ${MOCK_LLM_URL}\nmodels:\n  probe-model:\n    provider: probe\n    model: probe-model\n",
    ".agents/crow/.env": "PROBE_API_KEY=probe-mock-key\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.24/crow-cli-darwin-aarch64.tar.gz",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "darwin-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.24/crow-cli-darwin-x86_64.tar.gz",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.24/crow-cli-linux-aarch64.tar.gz",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.24/crow-cli-linux-x86_64.tar.gz",
        "cmd": "./crow-cli",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://github.com/crow-cli/crow-cli/releases/download/v0.1.24/crow-cli-windows-x86_64.zip",
        "cmd": "./crow-cli.exe",
        "args": [
          "acp"
        ]
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "crow-cli reads providers/models from ~/.agents/crow/config.yaml (documented openai-compatible shape); HOME=${WORK_DIR} lets sessionFiles plant the config pointing at the mock LLM.",
  "_synced": "acp-registry 1.0.0 · 2026-09-24"
}
