{
  "name": "qwen-code",
  "display": "Qwen Code",
  "vendor": "Alibaba Qwen Team",
  "version": "0.24.5",
  "description": "Alibaba's Qwen coding assistant",
  "repo": "QwenLM/qwen-code",
  "website": "https://qwenlm.github.io/qwen-code-docs/en/users/overview",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/qwen-code.svg",
  "license": "Apache-2.0",
  "install": null,
  "run": "npx -y @qwen-code/qwen-code@0.24.5 --acp --experimental-skills",
  "env": {
    "OPENAI_API_KEY": "probe-mock-key",
    "OPENAI_BASE_URL": "${MOCK_LLM_URL}",
    "OPENAI_MODEL": "probe-model"
  },
  "sessionFiles": {
    ".qwen/settings.json": {
      "security": {
        "auth": {
          "selectedType": "openai"
        }
      },
      "model": {
        "name": "probe-model"
      }
    }
  },
  "dist": {
    "type": "npx",
    "package": "@qwen-code/qwen-code@0.24.5",
    "args": [
      "--acp",
      "--experimental-skills"
    ]
  },
  "disabled": false,
  "selftest": false,
  "notes": "OpenAI-compatible provider selected via project .qwen/settings.json (searched upward from the session cwd) plus OPENAI_* env — every model call routes to the probe's mock LLM. No qwen OAuth account needed.",
  "_synced": "acp-registry 1.0.0 · 2026-09-25"
}
