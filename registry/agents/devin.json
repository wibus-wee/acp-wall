      "windows-aarch64": {
        "archive": "https://static.devin.ai/cli/3000.11.3/devin-3000.11.3-aarch64-pc-windows.zip",
        "cmd": "./bin\\devin.exe",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://static.devin.ai/cli/3000.11.3/devin-3000.11.3-x86_64-pc-windows.zip",
        "cmd": "./bin\\devin.exe",
        "args": [
          "acp"
