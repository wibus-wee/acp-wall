{
  "name": "stakpak",
  "display": "Stakpak",
  "vendor": "Stakpak Team <contact@stakpak.dev>",
  "version": "0.3.88",
  "description": "Open-source DevOps agent in Rust with enterprise-grade security",
  "repo": "stakpak/agent",
  "website": "https://stakpak.dev",
  "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/stakpak.svg",
  "license": "Apache-2.0",
  "install": "node tools/install-dist.mjs registry/agents/stakpak.json",
  "run": "${REPO_ROOT}/.cache/agents/stakpak/stakpak acp",
  "env": {
    "HOME": "${WORK_DIR}"
  },
  "sessionFiles": {
    ".stakpak/config.toml": "[profiles.default]\nprovider = \"local\"\nmodel = \"probe/probe-model\"\n\n[profiles.default.providers.probe]\ntype = \"custom\"\napi_endpoint = \"${MOCK_LLM_URL}\"\napi_key = \"probe-mock-key\"\n"
  },
  "dist": {
    "type": "binary",
    "per_platform": {
      "darwin-aarch64": {
        "archive": "https://github.com/stakpak/agent/releases/download/v0.3.88/stakpak-darwin-aarch64.tar.gz",
        "cmd": "./stakpak",
        "args": [
          "acp"
        ]
      },
      "darwin-x86_64": {
        "archive": "https://github.com/stakpak/agent/releases/download/v0.3.88/stakpak-darwin-x86_64.tar.gz",
        "cmd": "./stakpak",
        "args": [
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/stakpak/agent/releases/download/v0.3.88/stakpak-linux-aarch64.tar.gz",
        "cmd": "./stakpak",
        "args": [
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/stakpak/agent/releases/download/v0.3.88/stakpak-linux-x86_64.tar.gz",
        "cmd": "./stakpak",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://github.com/stakpak/agent/releases/download/v0.3.88/stakpak-windows-x86_64.zip",
        "cmd": "./stakpak.exe",
        "args": [
          "acp"
        ]
      }
    }
  },
  "disabled": false,
  "selftest": false,
  "notes": "Documented BYO-LLM path: ~/.stakpak/config.toml declares a custom OpenAI-compatible provider (type=custom, api_endpoint) pointed at the mock LLM; HOME=${WORK_DIR} confines ~/.stakpak. No stakpak account needed.",
  "_synced": "acp-registry 1.0.0 · 2026-09-18"
}
